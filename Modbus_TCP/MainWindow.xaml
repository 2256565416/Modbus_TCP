<Window x:Class="ModbusMasterWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Modbus TCP 主站" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 连接区域 -->
        <GroupBox Header="Modbus 连接" Grid.Row="0" Margin="0 0 0 10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="IP地址:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtIp" Text="127.0.0.1" Width="120" Margin="5 0"/>
                <TextBlock Text="端口:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPort" Text="502" Width="80" Margin="5 0"/>
                <TextBlock Text="从站地址:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSlaveId" Text="1" Width="60" Margin="5 0"/>
                <Button x:Name="btnConnect" Content="连接" Width="80" Margin="5 0" Click="BtnConnect_Click"/>
                <Button x:Name="btnDisconnect" Content="断开" Width="80" Margin="5 0" Click="BtnDisconnect_Click" IsEnabled="False"/>
            </StackPanel>
        </GroupBox>

        <!-- 读取区域 -->
        <GroupBox Header="读取数据" Grid.Row="1" Margin="0 0 0 10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="起始地址:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtStartAddress" Text="0" Width="60" Margin="5 0"/>
                <TextBlock Text="读取数量:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtReadCount" Text="10" Width="60" Margin="5 0"/>

                <Button Content="读线圈(0x)" Width="100" Margin="5 0" Click="BtnReadCoils_Click"/>
                <Button Content="读离散输入(1x)" Width="100" Margin="5 0" Click="BtnReadInputs_Click"/>
                <Button Content="读保持寄存器(4x)" Width="110" Margin="5 0" Click="BtnReadHoldingRegisters_Click"/>
                <Button Content="读输入寄存器(3x)" Width="110" Margin="5 0" Click="BtnReadInputRegisters_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 写入区域 -->
        <GroupBox Header="写入数据" Grid.Row="2" Margin="0 0 0 10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="地址:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtWriteAddress" Text="0" Width="60" Margin="5 0"/>
                <TextBlock Text="数值:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtWriteValue" Text="1" Width="60" Margin="5 0"/>

                <Button Content="写单个线圈" Width="100" Margin="5 0" Click="BtnWriteSingleCoil_Click"/>
                <Button Content="写单个保持寄存器" Width="120" Margin="5 0" Click="BtnWriteSingleRegister_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 日志区域 -->
        <GroupBox Header="运行日志" Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="listLog"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>